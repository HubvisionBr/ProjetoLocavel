#Include 'Protheus.ch'
#Include 'TopConn.ch'

/*
{Protheus.doc} UFATR003
Relatório Carta de Autuação/Carta de Multa Administrativa - Layout Fiel LOCAVEL
Tabelas: TRX (dados da Notificação de Autuação/Multa), FPA (para retornar o Contrato do Cliente)
@since Abril/2026
@type function
*/
User Function UFATR003()

    Local cRel := ""
    Private cAliasRel := GetNextAlias()
    Private cDataEmissao, cOficio, cNomCli, cCodContr, cGestor, cCodInfra, cDescInfra, cVeiculo, cPlaca,; 
        cDataOcor, cHoraOcor, cAIT, cVencMulta, cValDesc, cValInt, cNumFulcro, cPrazoIndica

    If GetQuery()
        cRel := GetHtml()
        GeraPdf(cRel)
    EndIf
    
    If Select(cAliasRel) > 0
        (cAliasRel)->(DbCloseArea())
    EndIf
Return

// Função para retornar os dados do relatório 
Static Function GetQuery()
    
    Local lRet := .F.
    Local cQuery := ""

    // Monta a query
    cQuery := " SELECT "
    cQuery += "     TRX.TRX_FILIAL, TRX.TRX_MULTA, TRX.TRX_NUMAIT, TRX.TRX_PLACA, TRX.TRX_DTINFR, TRX.TRX_RHINFR, "
    cQuery += "     TRX.TRX_CODINF, TRX.TRX_DTVECI, TRX.TRX_VALOR, TRX.TRX_PCTDSC, TRX.TRX_DTIND, "
    cQuery += "     TRX.TRX_CODBEM, TRX.TRX_NF, TRX.TRX_CIDINF, " //Tabela de Notificações/Multas
    cQuery += "     TSH.TSH_DESART AS TRX_DESART, " // Descrição da Infração da tabela TSH
    cQuery += "     FP0.FP0_CLINOM AS NOME_CLI, "
    cQuery += "     FP0.FP0_XLOCAL AS CONTRATO, "   // Número do Contrato
    cQuery += "     ST9.T9_NOME "   // Nome do veiculo
    cQuery += " FROM " + RetSqlName("TRX") + " TRX "
    
    // Join com TSH para pegar a descrição da Infração
    cQuery += " LEFT JOIN " + RetSqlName("TSH") + " TSH ON TSH_FILIAL = '"+FwxFilial("TSH")+"' "
    cQuery += "     AND TSH.TSH_CODINF = TRX.TRX_CODINF AND TSH.D_E_L_E_T_ = ' ' "
    
    // Join com FPA para localizar o contrato vinculado à placa do veículo
    cQuery += " LEFT JOIN " + RetSqlName("FPA") + " FPA ON "
    cQuery += "     FPA.FPA_XPLACA = TRX.TRX_PLACA AND FPA.D_E_L_E_T_ = ' ' "
    
    // Join com FP0 para pegar os dados do Cliente do Contrato 
    cQuery += " LEFT JOIN " + RetSqlName("FP0") + " FP0 ON "
    cQuery += "     FPA_FILIAL||FPA_PROJET = FP0_FILIAL||FP0_PROJET AND FP0_STATUS = '5' AND FP0.D_E_L_E_T_ = ' '"
    
    // Join com TSH para pegar a descrição da Infração
    cQuery += " LEFT JOIN " + RetSqlName("ST9") + " ST9 ON "
    cQuery += "     ST9.T9_CODBEM = TRX.TRX_CODBEM AND ST9.D_E_L_E_T_ = ' ' "

    cQuery += " WHERE "
    cQuery += "     TRX.TRX_MULTA = '" + TRX->TRX_MULTA + "' "
    cQuery += "     AND TRX.D_E_L_E_T_ = ' ' "
    cQuery := ChangeQuery(cQuery)

    dbUseArea(.T., "TOPCONN", TCGENQRY(,,cQuery), cAliasRel, .F., .T.)

    If !(cAliasRel)->(EoF())
    
        cDataEmissao := DToC(Date()) + " " + Time()
        cOficio      := (cAliasRel)->TRX_MULTA    
        cNomCli      := (cAliasRel)->NOME_CLI     
      //cCodContr    := (cAliasRel)->CONTRATO     
        cCodContr    := (cAliasRel)->TRX_CIDINF
        cGestor      := ""
        
        // DADOS DA INFRAÇÃO (CAMPOS TRX)
        cCodInfra    := (cAliasRel)->TRX_CODINF   
        cDescInfra   := (cAliasRel)->TRX_DESART   
      //cVeiculo     := (cAliasRel)->TRX_CODBEM
        cVeiculo     := AllTrim((cAliasRel)->T9_NOME)
        cPlaca       := (cAliasRel)->TRX_PLACA
        cDataOcor    := DToC(STOD((cAliasRel)->TRX_DTINFR)) 
        cHoraOcor    := (cAliasRel)->TRX_RHINFR   
        cAIT         := (cAliasRel)->TRX_NUMAIT

        // DADOS FINANCEIROS/PRAZOS (CAMPOS TRX)
        cVencMulta   := DToC(STOD((cAliasRel)->TRX_DTVECI)) 
        nValReal     := (cAliasRel)->TRX_VALOR
        nPercDesc    := (cAliasRel)->TRX_PCTDSC
        
        // Cálculos para o texto da Multa
        cValDesc     := Transform(nValReal * (1 - (nPercDesc/100)), "@E 999,999.92") 
        cValInt      := Transform(nValReal, "@E 999,999.92")
        cNumFulcro   := (cAliasRel)->TRX_NF
        
        // Prazo para Autuação (Data de Indicação de Condutor ou Limite)
        cPrazoIndica := DToC(STOD((cAliasRel)->TRX_DTIND))
        lRet := .T.
    EndIf
Return lRet

// Função para gerar o HTML do relatório
Static Function getHtml()
    Local cHtml           := ''
    Local cFontCourierNew := "'Courier New'"
    Local lMulta          := TRX->TRX_TPMULT <> "NOTIFICACAO"
  //Local cEmpFil         := cEmpAnt
    Local dDataAtual      := dDataBase

    cHtml += ' <meta http-equiv="Content-Type" content="text/html; charset=utf-8">'
    cHtml += '<!DOCTYPE html>'
    cHtml += '<html lang="pt-br">'
    cHtml += '<head>'
    cHtml += '    <meta charset="UTF-8">'
    cHtml += '    <title>' + Iif(lMulta, "Carta de Multa Administrativa", "Carta de Autuação") + '</title>'
    cHtml += getCss()
    cHtml += '</head>'
    cHtml += '<body>'
    cHtml += '<div class="container">'
    cHtml += '    <header>'
    cHtml += '        <div class="header-left">'
  //cHtml += '            ' + cDataEmissao + '<br>'
  //cHtml += '            ' + IIf(lMulta, "frmCartaMulta", "frmCartaAutuacao") + '<br>'
  //cHtml += '            Página #1'
    cHtml += '        </div>'
    cHtml += '        <div class="header-center">'
    cHtml += '            <h1>' + IIf(lMulta, "Carta de Multa Administrativa", "Carta de Autuação") + '</h1>'
    cHtml += '        </div>'
    cHtml += '        <div class="logo-container">'
 // cHtml += '            <img src="https://sua-url.com/logo_locavel.png" alt="Logo LOCAVEL" class="logo-image">'
    cHtml += '        </div>'
    cHtml += '    </header>'
    cHtml += '    <div class="document-info">'
    cHtml += '        Moreno (PE), '+ cValtoChar(Day(dDataAtual)) + " de "+ MesExtenso(dDataAtual)+ " de "+ cValtoChar(Year(dDataAtual)) + '<br><br>'
    cHtml += '        Ofício Nº: ' + cOficio + '<br><br>'
    cHtml += '        <strong>' + cNomCli + '</strong><br>'
    cHtml += '        <strong>Contrato: ' + cCodContr + '</strong><br><br>'
  //cHtml += '        A/C.: ' + cGestor
    cHtml += '    </div>'
    cHtml += '    <div class="subject">'
    cHtml += '        ' + If(lMulta, "REF. PAGAMENTO DE INFRAÇÃO DE TRÂNSITO", "Ref.: Notificação de Autuação por Infração de Trânsito")
    cHtml += '    </div>'
    cHtml += '    <div class="content">'
    cHtml += '        <p>Prezado(a) Sr(a),</p>'
    
    If lMulta
        // CONTEÚDO DINÂMICO: MULTA
        cHtml += '        <p>Por meio desta, viemos lhe informar que estamos emitindo e lhe enviando junto a esta um boleto de cobrança referente a multa de trânsito no Artigo ' + cCodInfra + ' - ' + cDescInfra +', que foi identificada como sendo de sua responsabilidade pela condução do veículo ' + cVeiculo + ' de placa ' + cPlaca + ' ocorrida no dia ' + cDataOcor + ' às ' + cHoraOcor + ' horas conforme AIT: nº ' + cAIT + '.</p>'
        cHtml += '        <p>Esta responsabilidade se confirma através do Contrato Nº ' + cNumFulcro + ' com fulcro na cláusula das obrigações da contratante.</p>'
        cHtml += '        <p>Informamos que a multa em questão tem vencimento para <strong>' + cVencMulta + '</strong> com o valor de <strong>R$ ' + cValDesc + '</strong>.</p>'
        cHtml += '        <p>Lembramos que caso a mesma não seja quitada até a data de vencimento, o benefício do desconto de 20% concedido pelo órgão autuador perde a validade, ficando assim o valor integral da multa em R$ ' + cValInt + ' acrescido da taxa administrativa de 0,00 % à ser paga.</p>'
    Else
        // CONTEÚDO DINÂMICO: AUTUAÇÃO
        cHtml += '        <p>Foi apurada uma autuação de infração de trânsito no Artigo ' + cCodInfra + ' - ' + cDescInfra + ', no período de locação realizada no veículo ' + cVeiculo +  ' de placa ' + cPlaca + ' ocorrida no dia ' + cDataOcor + ' às ' + cHoraOcor + 'h conforme Nº de AIT: ' + cAIT + ', fazendo-se necessária a indicação do nome do condutor responsável no prazo até ' + cPrazoIndica + '.</p>'
        cHtml += '        <p>Conforme previsto no Código Nacional de Trânsito (Art. 257, Parágrafos 7º e 8º), o proprietário do veículo tem o dever de indicar o condutor responsável pelo carro ao Órgão de Trânsito competente, sob pena de agravamento da infração, com cobrança de valores adicionais.</p>'
        cHtml += '        <p>A partir do recebimento deste ofício, o usuário torna-se parte legítima para o exercício de seu direito de defesa dentro do prazo junto ao Órgão de Trânsito competente, podendo consultar seu advogado para obter orientação como proceder.</p>'
        cHtml += '        <p>Anexo segue o formulário para preenchimento dos dados do condutor infrator ou requerimento para proceder com a defesa caso julgue improcedente a infração apontada.</p>'
    EndIf

    cHtml += '        <p>' + If(lMulta, "Pedimos que em caso de dúvida ou não recebimento do boleto para pagamento da mesma entrar em contato com o nosso setor financeiro.", "Atenciosamente,") + '</p>'
    cHtml += '    </div>'
    cHtml += '    <div class="signature-section">'
    cHtml += '        <div class="signature-info">'
  //cRet  += '<td colspan="2" class="title-box">' + AllTrim(Posicione("SM0", 1, cEmpFil, "M0_NOMECOM")) + '<br>'
  //cHtml += '            <strong>' + If(lMulta, AllTrim(Posicione("SM0", 1, cEmpFil, "M0_NOMECOM")), "") + '</strong><br>'
    cHtml += '            <strong>' + SM0->M0_FULNAME + '</strong><br>' // Retorna o Nome Completo da Empresa/Filial
    cHtml += '                                                    <br>'
    cHtml += '                                                    <br>'
    cHtml += '            ________________________________________<br>'
    //cHtml += '            ' + If(lMulta, "Gerente Financeiro", "Gerente Adm Financeiro")
    cHtml += '        </div>'
    // cHtml += '        <div class="signature-box">'
    // cHtml += '            <div style="font-family: '+cFontCourierNew+', monospace; color: blue; transform: rotate(-5deg); font-size: 20px; border: 1px dashed #ccc; padding: 10px;">Assinado</div>'
    // cHtml += '        </div>'
    cHtml += '    </div>'

    cHtml += '    <footer>'
    //cHtml += '        Locavel Locação de Veículos e Serviços Ltda.<br>'
    //cHtml += '        Avenida Presidente Vargas, 164 &nbsp;&nbsp;&nbsp; 54800000 &nbsp;&nbsp;&nbsp; Bonança &nbsp;&nbsp;&nbsp; Moreno &nbsp;&nbsp;&nbsp; PE &nbsp;&nbsp;&nbsp; 00388838000102'
    cHtml += '    </footer>'
    cHtml += '</div>'
    cHtml += '</body>'
    cHtml += '</html>'
Return cHtml

// Função para gerar o CSS do relatório
Static Function getCss()
    Local cCss := ""
    cCss += "    <style>"
    cCss += "        body {"
    cCss += "            font-family: Arial, sans-serif;"
    cCss += "            background-color: #f0f0f0;"
    cCss += "            margin: 0;"
    cCss += "            padding: 20px;"
    cCss += "            color: #333;"
    cCss += "        }"
    cCss += "        .container {"
    cCss += "            width: 180mm; /* Tamanho A4 aproximado */"
    cCss += "            min-height: 260mm;"
    cCss += "            background-color: white;"
    cCss += "            margin: 0 auto;"
    cCss += "            padding: 10mm;"
    cCss += "            box-shadow: 0 0 10px rgba(0,0,0,0.1);"
    cCss += "            box-sizing: border-box;"
    cCss += "            position: relative;"
    cCss += "        }"
    cCss += "        header {"
    cCss += "            display: flex;"
    cCss += "            justify-content: space-between;"
    cCss += "            align-items: flex-start;"
    cCss += "            border-bottom: 1px solid #ccc;"
    cCss += "            padding-bottom: 10px;"
    cCss += "            font-size: 11px;"
    cCss += "            margin-bottom: 20px;"
    cCss += "        }"
    cCss += "        .header-left {"
    cCss += "            line-height: 1.4;"
    cCss += "        }"
    cCss += "        .header-center {"
    cCss += "            text-align: center;"
    cCss += "            flex-grow: 1;"
    cCss += "        }"
    cCss += "        .header-center h1 {"
    cCss += "            font-size: 14px;"
    cCss += "            margin: 0;"
    cCss += "            text-transform: uppercase;"
    cCss += "        }"
    cCss += "        .logo-container {"
    cCss += "            text-align: right; /* Mantém o alinhamento à direita no cabeçalho */"
    cCss += "            flex-shrink: 0;   /* Impede que a logo seja comprimida */"
    cCss += "            margin-left: 20px; /* Espaçamento do texto central */"
    cCss += "        }"
    cCss += "        .logo-image {"
    cCss += "            max-width: 150px; /* Largura máxima aproximada para a logo no papel A4 */"
    cCss += "            height: auto;      /* Mantém a proporção da imagem */"
    cCss += "            display: block;    /* Remove espaços extras abaixo da imagem */"
    cCss += "        }"
    cCss += "        .document-info {"
    cCss += "            font-size: 13px;"
    cCss += "            margin-bottom: 30px;"
    cCss += "        }"
    cCss += "        .subject {"
    cCss += "            font-weight: bold;"
    cCss += "            text-decoration: underline;"
    cCss += "            margin: 30px 0;"
    cCss += "        }"
    cCss += "        .content {"
    cCss += "            font-size: 13px;"
    cCss += "            line-height: 1.6;"
    cCss += "            text-align: justify;"
    cCss += "        }"
    cCss += "        .content p {"
    cCss += "            margin-bottom: 20px;"
    cCss += "        }"
    cCss += "        .signature-section {"
    cCss += "            margin-top: 60px;"
    cCss += "            display: flex;"
    cCss += "            justify-content: space-between;"
    cCss += "        }"
    cCss += "        .signature-info {"
    cCss += "            font-size: 13px;"
    cCss += "        }"
    cCss += "        .signature-box {"
    cCss += "            text-align: center;"
    cCss += "            width: 200px;"
    cCss += "        }"
    cCss += "        .signature-image {"
    cCss += "            width: 120px;"
    cCss += "            opacity: 0.8;"
    cCss += "            margin-bottom: -10px;"
    cCss += "        }"
    cCss += "        footer {"
    cCss += "            position: absolute;"
    cCss += "            bottom: 20px;"
    cCss += "            left: 0;"
    cCss += "            right: 0;"
    cCss += "            text-align: center;"
    cCss += "            font-size: 10px;"
    cCss += "            border-top: 1px solid #ccc;"
    cCss += "            padding-top: 10px;"
    cCss += "            margin: 0 40px;"
    cCss += "        }"
    cCss += "        @media print {"
    cCss += "            body { background-color: white; margin: 0; padding: 0; }"
    cCss += "            .container { box-shadow: none; margin: 0; width: 100%; min-height: auto; }"
    cCss += "            footer { position: fixed; bottom: 10mm; } /* Garante o rodapé no lugar certo */"
    cCss += "        }"
    cCss += "    </style>"
Return cCss

// Função para gerar o PDF a partir do HTML
Static Function GeraPdf(cHtml)
    Local cFileSrv := "\spool\x_locavel_" + AllTrim(RetCodUsr()) + ".html"
    Local cFileCli := GetClientDir() + "x_LOCAVEL.html"
    
    // Auto-executa o print ao abrir
    cHtml += "<script type='text/javascript'>window.onload = function() { window.print(); }</script>"
    
    If MemoWrite(cFileSrv, EncodeUTF8(cHtml))
        If __CopyFile(cFileSrv, cFileCli)
            ShellExecute("OPEN", cFileCli, "", "", 1)
        EndIf
    EndIf
Return
