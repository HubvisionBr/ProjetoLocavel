#Include 'Protheus.ch'
#Include 'TopConn.ch'

/*/{Protheus.doc} UFATR002
Relatorio de Ordem de Servico - Layout Fiel LOCAVEL
Tabelas: STJ (OS), STL (Itens), ST9 (Bens)
/*/
User Function UFATR002()
    
    Private cQuery    := ""
    Private cHTML     := ""
    Private nTotPeca  := 0
    Private nTotServ  := 0

    cOSDe  := STJ->TJ_ORDEM
    cOSAté := STJ->TJ_ORDEM
    MontaQuery(cOSDe, cOSAté)
    IF MontaDados()
        GeraPdf()
    ENDIF
Return

Static Function MontaQuery(cDe, cAté)
    cQuery := " SELECT STJ.TJ_FILIAL, STJ.TJ_ORDEM, STJ.TJ_CODBEM, STJ.TJ_POSCONT, STJ.TJ_TERMINO, TJ_DTMRINI, TJ_HOMRINI,"
    cQuery += " ST9.T9_PLACA, ST9.T9_CORVEI, ST9.T9_MODELO, ST9.T9_ANOMOD, ST9.T9_CHASSI, "
    cQuery += " FP0.FP0_XLOCAL, FP0.FP0_CLICGC, FP0.FP0_CLIEND, FP0.FP0_CLIDDD, FP0.FP0_CLITEL"
    cQuery += " FROM " + RetSqlName("STJ") + " STJ "
    cQuery += " INNER JOIN " + RetSqlName("ST9") + " ST9 ON ST9.T9_CODBEM = STJ.TJ_CODBEM "
    cQuery += " INNER JOIN " + RetSqlName("FPA") + " FPA ON FPA.FPA_XPLACA = STJ.TJ_BEMPAI "
    cQuery += " INNER JOIN " + RetSqlName("FP0") + " FP0 ON FPA_FILIAL||FPA_PROJET = FP0_FILIAL||FP0_PROJET AND FP0_STATUS = '5'"
    cQuery += " WHERE STJ.TJ_FILIAL = '" + xFilial("STJ") + "' "
    cQuery += " AND STJ.TJ_ORDEM >= '" + cDe + "' "
    cQuery += " AND STJ.TJ_ORDEM <= '" + cAté + "' "
    cQuery += " AND STJ.D_E_L_E_T_ = '' AND ST9.D_E_L_E_T_ = '' AND FPA.D_E_L_E_T_ = '' AND FP0.D_E_L_E_T_ = ''"
    cQuery := ChangeQuery(cQuery)
Return

Static Function MontaDados()
    Local cAliasOS := GetNextAlias()
    Local lRet     := .F.
    
    dbUseArea(.T., "TOPCONN", TCGENQRY(,,cQuery), cAliasOS, .F., .T.)

    If !(cAliasOS)->(Eof())
        lRet := .T.
        // charset windows-1252 resolve os problemas de acentuação no Protheus
        cHTML := "<html><head><meta charset='windows-1252'>" + GetEstilo() + "</head><body>"

        While !(cAliasOS)->(Eof())
            nTotPeca := 0 
            nTotServ := 0

            cHTML += '<div class="container">'
            cHTML += GetCabecalho((cAliasOS)->TJ_ORDEM,(cAliasOS)->TJ_FILIAL)
            cHTML += GetIdentificacao(cAliasOS)
            cHTML += GetRequisicao(cAliasOS)
            cHTML += GetItensSTL((cAliasOS)->TJ_ORDEM) 
            cHTML += GetTotais()
            cHTML += GetAssinaturas()
            cHTML += '</div>'
            cHTML += '<div style="page-break-after: always; border:none;"></div>'

            (cAliasOS)->(dbSkip())
        EndDo
        cHTML += "</body></html>"
    Endif
    (cAliasOS)->(dbCloseArea())
Return lRet

Static Function GetEstilo()
    Local cCSS := "<style>"
    cCSS += "body { font-family: Arial, sans-serif; font-size: 10px; margin: 0; padding: 20px; }"
    cCSS += ".container { width: 100%; max-width: 800px; margin: auto; border: 2px solid #000; }"
    cCSS += "table { width: 100%; border-collapse: collapse; }"
    cCSS += "th, td { border: 1px solid #000; padding: 4px; text-align: left; vertical-align: top; }"
    cCSS += ".header-table td { border: none; border-bottom: 1px solid #000; }"
    cCSS += ".title-box { font-weight: bold; font-size: 14px; }"
    cCSS += ".section-title { background-color: #f2f2f2; font-weight: bold; text-align: center; text-transform: uppercase; }"
    cCSS += ".label { font-weight: bold; font-size: 9px; display: block; text-transform: uppercase; color: #333; }"
    cCSS += ".text-right { text-align: right; }"
    cCSS += ".bg-gray { background-color: #f2f2f2; }"
    cCSS += ".line { border-top: 1px solid #000; width: 80%; margin: 0 auto 5px auto; }"
    cCSS += ".footer-signatures { margin-top: 50px; border: none !important; }"
    cCSS += ".footer-signatures td { border: none !important; text-align: center; width: 50%; padding-top: 10px; }"
    cCSS += "</style>"
Return cCSS

Static Function GetCabecalho(cNumOS, cFilOs)
    Local cRet := ""
    Local cEmpFil := cEmpAnt + cFilOS // Chave de busca para a SM0

    cRet += '<table class="header-table"><tr>'

    // Busca Razão Social (M0_NOMECOM) via Posicione
    cRet += '<td colspan="2" class="title-box">' + AllTrim(Posicione("SM0", 1, cEmpFil, "M0_NOMECOM")) + '<br>'

    // Busca CNPJ via FWCgc (Passando a filial como parâmetro)
    cRet += '<span style="font-size: 11px;">CNPJ: ' + Transform(GetAdvFVal("SM0", "M0_CGC", cEmpFil, 1), "@R 99.999.999/9999-99") + '</span></td>'

    cRet += '<td style="text-align:right" class="title-box">O.S. Nº: ' + cNumOS + '</td></tr>'
    cRet += '<tr><td colspan="3" style="font-size: 9px;">' 

    // Monta o endereço completo usando Posicione para cada campo
    cRet += AllTrim(Posicione("SM0", 1, cEmpFil, IF(SM0->(FieldPos("M0_ENDENT")) > 0, "M0_ENDENT", "M0_END"))) + ", " 
    cRet += AllTrim(Posicione("SM0", 1, cEmpFil, IF(SM0->(FieldPos("M0_BAIENT")) > 0, "M0_BAIENT", "M0_BAIRRO"))) + " - " 
    cRet += AllTrim(Posicione("SM0", 1, cEmpFil, IF(SM0->(FieldPos("M0_CIDENT")) > 0, "M0_CIDENT", "M0_CIDADE"))) + "/" 
    cRet += Posicione("SM0", 1, cEmpFil, IF(SM0->(FieldPos("M0_ESTENT")) > 0, "M0_ESTENT", "M0_EST")) + '<br>'

    // Busca Telefone
    cRet += 'FONE: ' + AllTrim(Posicione("SM0", 1, cEmpFil, "M0_TEL")) 
    cRet += ' / SITE: www.grupolocavel.com.br</td></tr></table>'
    // cRet += '<table class="header-table"><tr>'
    // cRet += '<td colspan="2" class="title-box">LOCAVEL LOCAÇÃO DE SERVIÇOS E VEICULOS LTDA<br>'//TODO: Buscar razão social da empresa da OS
    // cRet += '<span style="font-size: 11px;">CNPJ: 00.388.838/0001-02</span></td>'//TODO: Buscar CNPJ da empresa da OS
    // cRet += '<td style="text-align:right" class="title-box">O.S. Nº: '+cNumOS+'</td></tr>'
    // cRet += '<tr><td colspan="3" style="font-size: 9px;">AVENIDA PRESIDENTE DUTRA 347, IMBIRIBEIRA - RECIFE, PE<br>'//TODO: Buscar endereço da empresa da OS
    // cRet += 'FONE: 3878-1660 / SITE: www.grupolocavel.com.br</td></tr></table>'//TODO: Buscar telefone e site da empresa da OS
Return cRet

Static Function GetIdentificacao(cAlias)
    Local cRet     := ""
    Local cNomeCli := (cAlias)->FP0_XLOCAL 
    Local cCnpj    := (cAlias)->FP0_CLICGC
    Local cEnd     := (cAlias)->FP0_CLIEND
    Local cFone    := Alltrim((cAlias)->FP0_CLIDDD) + " " + Alltrim((cAlias)->FP0_CLITEL)

    cRet += '<table>'
    cRet += '<tr><td colspan="2" class="section-title">Identificação do Cliente / Destinatário / Contrato</td><td colspan="2" class="section-title">Dados do Veículo</td></tr>'
    cRet += '<tr><td style="width: 30%;"><span class="label">Cliente:</span>'+cNomeCli+'</td>'
    cRet += '<td style="width: 20%;"><span class="label">Data:</span>'+DTOC(STOD((cAlias)->TJ_DTMRINI))+'</td>'
    cRet += '<td style="width: 25%;"><span class="label">Placa:</span>'+(cAlias)->T9_PLACA+'</td>'
    cRet += '<td style="width: 25%;"><span class="label">Sinistro:</span> ( ) NÃO ( ) SIM</td></tr>'
    cRet += '<tr><td><span class="label">CNPJ:</span>'+cCnpj+'</td>'
    cRet += '<td><span class="label">Hora:</span>'+(cAlias)->TJ_HOMRINI+'</td>'
    cRet += '<td><span class="label">Cor:</span>'+(cAlias)->T9_CORVEI+'</td>'
    cRet += '<td><span class="label">Solicit. Armazen:</span></td></tr>'//TODO:TL_NUMSA
    cRet += '<tr><td><span class="label">Endereço:</span>'+cEnd+'</td>'
    cRet += '<td><span class="label">Fone:</span>'+cFone+'</td>'
    cRet += '<td><span class="label">Marca:</span>'+'</td>'
    cRet += '<td><span class="label">Solicit. Compra:</span></td></tr>'
    cRet += '<tr><td colspan="2" class="section-title">Fornecedor Externo</td><td><span class="label">KM:</span>'+Transform((cAlias)->TJ_POSCONT,"@999,999.99")+'</td>'
    cRet += '<td><span class="label">Modelo:</span>'+(cAlias)->T9_MODELO+'</td></tr>'
    cRet += '<tr><td colspan="2"><span class="label">Informações Adicionais:</span></td><td><span class="label">Ano/Mod:</span>'+(cAlias)->T9_ANOMOD+'</td>'
    cRet += '<td><span class="label">Chassi:</span>'+(cAlias)->T9_CHASSI+'</td></tr>'
    cRet += '</table>'
Return cRet

Static Function GetRequisicao(cAlias)
    Local cRet := ""
    cRet += '<table>'
    cRet += '<tr><td style="width: 50%;"><span class="label">Solicitado por:</span></td><td style="width: 50%;"><span class="label">Tipo de Requisição:</span></td></tr>'//TODO: TJ_USUARIO
    cRet += '<tr><td><span class="label">Requisitante(s):</span></td><td><span class="label">Situação:</span>'+Iif((cAlias)->TJ_TERMINO=="S",'Finalizada','Aberto')+'</td></tr>'
    cRet += '</table>'
Return cRet

Static Function GetItensSTL(cNumOS)
    Local cAliasSTL := GetNextAlias()
    Local cRet      := ""
    Local cQry      := "SELECT TL_CODIGO, TL_QUANTID FROM " + RetSqlName("STL") 
    cQry += " WHERE TL_FILIAL = '" + xFilial("STL") + "' AND TL_ORDEM = '"+cNumOS+"' AND D_E_L_E_T_ = '' "
    
    dbUseArea(.T., "TOPCONN", TCGENQRY(,,cQry), cAliasSTL, .F., .T.)
    
    cRet := '<table><tr><td colspan="5" class="section-title">Itens da Ordem de Serviço (Produtos e Serviços)</td></tr>'
    cRet += '<tr class="bg-gray"><td style="width: 10%;"><span class="label">Código</span></td><td><span class="label">Descrição</span></td><td style="width: 10%;"><span class="label">Qtd</span></td><td style="width: 15%;"><span class="label">Vlr. Unit</span></td><td style="width: 15%;" class="text-right"><span class="label">Valor Total</span></td></tr>'
    
    While !(cAliasSTL)->(Eof())
        cRet += '<tr>'
        cRet += '<td>'+(cAliasSTL)->TL_CODIGO+'</td>'
        cRet += '<td>'+Posicione("SB1",1,FwxFilial("SB1")+PADR((cAliasSTL)->TL_CODIGO,TamSx3("B1_COD")[1]),"B1_DESC")+'</td>'
        cRet += '<td>'+cValToChar((cAliasSTL)->TL_QUANTID)+'</td>'
        cRet += '<td>'+'</td>'
        cRet += '<td class="text-right">'+'</td>'
        cRet += '</tr>'
        // nTotPeca += (cAliasSTL)->TL_VALTOTAL
        (cAliasSTL)->(dbSkip())
    EndDo
    
    IF nTotPeca == 0
        cRet += '<tr><td colspan="5" style="text-align:center">Nenhum item encontrado nesta OS</td></tr>'
    ENDIF
    cRet += '</table>'
    (cAliasSTL)->(dbCloseArea())
Return cRet

Static Function GetTotais()
    Local cRet := ""
    cRet += '<table style="width: 40%; margin-left: 60%;">'
    cRet += '<tr><td class="bg-gray"><span class="label">Valor Final:</span></td><td class="text-right"><strong>R$ '+'</strong></td></tr>'
    cRet += '</table>'
Return cRet

Static Function GetAssinaturas()
    Local cRet := ""
    cRet += '<table class="footer-signatures"><tr>'
    cRet += '<td><div class="line"></div>Ass. Gestor</td>'
    cRet += '<td><div class="line"></div>Ass. Requisitante</td></tr></table>'
Return cRet

Static Function GeraPdf()
    Local cFileSrv := "\spool\os_locavel_" + Alltrim(RetCodUsr()) + ".html"
    Local cFileCli := GetClientDir() + "OS_LOCAVEL.html"
    cHTML += "<script type='text/javascript'>window.onload = function() { window.print(); }</script>"
    If MemoWrite(cFileSrv, cHTML)
        If __CopyFile(cFileSrv, cFileCli)
            ShellExecute("OPEN", cFileCli, "", "", 1)
        EndIf
    EndIf
Return
